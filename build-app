#!/bin/bash
# Builds "Screenshot Rake.app" and copies it to /Applications.
#   ./build-app            build and install
#   ./build-app --no-install   just build it here
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
APP="$DIR/build/Screenshot Rake.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources/art"

echo "Compiling..."
swiftc -O -swift-version 5 "$DIR/ScreenshotRake.swift" -o "$APP/Contents/MacOS/Screenshot Rake"
cp -R "$DIR/art/frames" "$APP/Contents/Resources/art/frames"

# App icon from art/AppIcon.png
ICONSET="$DIR/build/AppIcon.iconset"
rm -rf "$ICONSET"; mkdir -p "$ICONSET"
for s in 16 32 128 256 512; do
  sips -z $s $s "$DIR/art/AppIcon.png" --out "$ICONSET/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) "$DIR/art/AppIcon.png" --out "$ICONSET/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/AppIcon.icns"
rm -rf "$ICONSET"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Screenshot Rake</string>
  <key>CFBundleDisplayName</key><string>Screenshot Rake</string>
  <key>CFBundleIdentifier</key><string>io.github.c-h-i-a-m-a-k-a.screenshot-rake</string>
  <key>CFBundleExecutable</key><string>Screenshot Rake</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Custodian Cashew uses Finder to find screenshot icons on your desktop and move them into Leaf Pile.</string>
</dict>
</plist>
PLIST

codesign --force --deep --sign - "$APP" >/dev/null 2>&1
echo "Built $APP"

if [ "$1" != "--no-install" ]; then
  pkill -x "Screenshot Rake" 2>/dev/null || true
  rm -rf "/Applications/Screenshot Rake.app"
  cp -R "$APP" "/Applications/"
  echo "Installed to /Applications/Screenshot Rake.app"
fi
